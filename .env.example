COMPOSE_PROJECT_NAME=guantou
ENVIRONMENT=development

# Local ports
BACKEND_PORT=8000
FRONTEND_PORT=8181
# Plain docker compose uses static-only frontend nginx, so point H5 to backend directly.
# Traefik compose uses guantou.localhost for H5 and api.guantou.localhost for Django.
FRONTEND_BACKEND_URL=http://localhost:8000
TRAEFIK_PORT=80
TRAEFIK_FRONTEND_BACKEND_URL=http://api.guantou.localhost
# Frontend build-time switch; keep phone-code login hidden until SMS delivery is available.
VITE_PHONE_CODE_LOGIN_ENABLED=false

# Image/container names
BACKEND_IMAGE=guantou-backend
BACKEND_CONTAINER=guantou-backend
FRONTEND_IMAGE=guantou-frontend
FRONTEND_CONTAINER=guantou-frontend

# Django/runtime secrets for local development
SECRET_KEY=dev-secret-key
JWT_KEY=dev-jwt-key
# 第一方产品事件原始明细保留天数；服务端拒绝大于 90 的配置。
PRODUCT_EVENT_RETENTION_DAYS=90
# JWT is sent as Authorization: Bearer <token>. Anonymous visitor and audit
# tracking do not require extra environment variables.

# Passwordless phone login is in demo-delivery mode until an SMS provider is
# connected. Demo mode returns the short-lived code to the requesting client;
# it must be disabled before using real phone numbers in production.
PHONE_CODE_DEMO_MODE=true
PHONE_CODE_TTL_SECONDS=300
PHONE_CODE_THROTTLE_SECONDS=60
DEFAULT_AVATAR_URL=https://cos.edialect.top/website/默认头像.jpg

# Service credentials (required and validated when ENVIRONMENT=production)
COS_SECRET_ID=DEFAULT_COS_SECRET_ID
COS_SECRET_KEY=DEFAULT_COS_SECRET_KEY
COS_BUCKET=DEFAULT_COS_BUCKET
COS_REGION=DEFAULT_COS_REGION
APP_ID=DEFAULT_APP_ID
# Preferred spelling. APP_SECRECT remains supported only for old local env files.
APP_SECRET=DEFAULT_APP_SECRET
# Optional, distinct WeChat web OAuth application. Never reuse mini-program keys.
WEB_APP_ID=
WEB_APP_SECRET=
EMAIL_HOST=DEFAULT_EMAIL_HOST
EMAIL_HOST_USER=DEFAULT_EMAIL_HOST_USER
EMAIL_HOST_PASSWORD=DEFAULT_EMAIL_HOST_PASSWORD
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_CODE_TTL_SECONDS=600
EMAIL_CODE_THROTTLE_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
DEFAULT_FROM_EMAIL=DEFAULT_DEFAULT_FROM_EMAIL
